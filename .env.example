# ---------------------------------------------------------------------------
# Market data provider
# ---------------------------------------------------------------------------
# "demo" -> deterministic synthetic data, always available, clearly labelled.
# "real" -> live provider. Requires MARKET_DATA_BASE_URL (and usually a key).
MARKET_DATA_PROVIDER=demo
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_CACHE_DIR=.cache/marketdata

# ---------------------------------------------------------------------------
# Financial assumptions (all configurable; nothing is hard-coded in the maths)
# ---------------------------------------------------------------------------
RISK_FREE_RATE=0.065
DEFAULT_LOOKBACK_YEARS=10
DEFAULT_REBALANCE_FREQUENCY=quarterly
TRADING_DAYS_PER_YEAR=252
DEFAULT_TRANSACTION_COST_BPS=10
VAR_CONFIDENCE=0.95

# ---------------------------------------------------------------------------
# Engine limits
# ---------------------------------------------------------------------------
DEFAULT_CANDIDATE_PORTFOLIOS=25000
MAX_CANDIDATE_PORTFOLIOS=50000
MAX_MONTE_CARLO_PATHS=50000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=INFO
